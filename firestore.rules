rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 내 사용자 정보(이름, 소속 가족)는 본인만 읽고 쓸 수 있음
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 초대 코드 -> 가족 ID 조회용. 코드를 알아야만 get 가능(목록 조회 불가), 한 번 만들면 수정 불가
    match /invites/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['familyId']);
      allow list, update, delete: if false;
    }

    match /families/{fid} {
      // 가족 만들기: 구성원은 나 한 명으로 시작
      allow create: if request.auth != null
                    && request.resource.data.members == [request.auth.uid];

      // 가족 구성원만 읽기 가능
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;

      // 구성원은 수정 가능(예산 설정, 탈퇴 등).
      // 아직 구성원이 아닌 사람은 "자기 자신 한 명을 members에 추가"하는 경우에만 가능(초대 코드 입장)
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        )
      );

      // 고정 지출 항목도 가족 구성원만 읽고 쓸 수 있음
      match /fixed/{iid} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
      }

      // 수입/지출 내역은 가족 구성원만 읽고 쓸 수 있음
      match /transactions/{tid} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
      }
    }
  }
}
